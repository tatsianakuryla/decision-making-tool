{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./decision-making-tool/dist",
    "rootDir": "./decision-making-tool/src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "resolveJsonModule": true
  },
  "include": [
    "decision-making-tool/src/**/*",
    "commitlint.config.js",
    "webpack.config.js",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules"]
}
